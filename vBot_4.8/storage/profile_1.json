  "ingame_hotkeys": "local function findWindowByTitle(widget, title)\n    if not widget or not widget.getChildren then return nil end\n    local ok, text = pcall(function() return widget:getText() end)\n    if ok and text == title then\n        return widget:getId()\n    end\n    for _, child in ipairs(widget:getChildren()) do\n        local found = findWindowByTitle(child, title)\n        if found then return found end\n    end\n    return nil\nend\n\nmacro(1500, \"Say Supply Stash ID\", function()\n    local root = g_ui.getRootWidget()\n    local foundId = findWindowByTitle(root, \"Supply Stash\")\n    if foundId then\n        say(foundId)\n    end\nend)",
