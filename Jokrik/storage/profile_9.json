  "ingame_hotkeys": "UI.Separator()\n\nlocal spell = \"utani evado\"\nlocal monsters = 1\n\nmacro(1000, \"Utani Evado\", function()\nif g_game.isAttacking() then\n    if mana() > 180 then\n\n          say(spell)\n        delay(120000)\n\n    end\nend\nend) \n\nlocal spell = \"exiva ocultus\"\nlocal monsters = 1\n\nmacro(1000, \"Shadow\", function()\n    if mana() > 180 then\n\n          say(spell)\n        delay(31000)\n\n    end\nend) \n\nlocal spell3= \"utito tempo\"\n\nmacro(100, \"Utito Tempo\", function()\nif g_game.isAttacking() then\n    if mana() > 290 then\n          say(spell3)\n        delay(10000)\n    end\nend\nend) \n\n--Revive pet\nlocal useHerb = true\nlocal petBodies = {8127,8128} -- \n\nmacro(500,\"Revive pet\", function()\n    for i, tile in ipairs(g_map.getTiles(posz())) do\n        for u,item in ipairs(tile:getItems()) do\n            if useHerb and table.find(petBodies, item:getId()) and findItem(34234) then\n                useWith(34234, item)\n            end\n        end\n    end\nend)\n\nlocal amuletID = 3081\nlocal mightID = 3048\nlocal belowHealamulet = 101\nlocal belowHealring = 60\n\nlocal ssa = macro(100, \"MACRO SSA\", function()\n\n    if getNeck() == nil or getNeck():getId() ~= amuletID then\n      g_game.equipItemId(amuletID)\ndelay(200)\n    end\nend)\n\nmacro(500, \"Pectus\", function()\n    if not g_game.isAttacking() then return end\n    local conTarget = g_game.getAttackingCreature()\n    if conTarget and conTarget:getHealthPercent() < 15 then\n        if manapercent() > 75 then\n          say(\"pectus cruentus\")\n          delay(4500)\n        end\n    end\nend)\n\nlocal amulet = 3051\nlocal equip_ammy = 34344\n\nSsa = macro(100, \"UTAMO GARRA\", function() \n    if hppercent() <= 80 and (getFinger() == null or getFinger():getId() ~= amulet) then\n            g_game.equipItemId(amulet)\n            delay(200)\n    elseif hppercent() >= 90 and (getFinger() == null or equip_ammy and getFinger():getId() ~= equip_ammy) then\n        g_game.equipItemId(equip_ammy)\n        delay(200)\n    end\nend)\n\nlocal urToolId = 5908 -- your tool id here dat spark\nlocal knifeBodies = {16194, 16197}  -- bodies id here {1111, 2222, 3333}\n\nm2 = macro(500, \"Knife Bodies\", function()\n  for i, tile in ipairs(g_map.getTiles(posz())) do\n    local item = tile:getTopThing()\n    if item and item:isContainer() then\n      if math.max(math.abs(posx()-tile:getPosition().x), math.abs(posy()-tile:getPosition().y)) <= 5 then\n        if table.find(knifeBodies, item:getId()) and findItem(urToolId) then\n          useWith(urToolId, item)\n          CaveBot.delay(500)\n          return\n        end\n      end\n    end\n  end\nend)\n\nlocal useStake = true -- DON'T CHANGE\nlocal mana = 50 -- ABOVE MANA\nlocal stake = 5942 -- BLESSED STAKE ID \n\nlocal stakeBodies = {6006,5995, 4097} -- DEAD ID\n\nmacro(500,\"Stake Bodies\", function()\n  for i, tile in ipairs(g_map.getTiles(posz())) do\n    for u,item in ipairs(tile:getItems()) do\n      if manapercent() >= mana then\n        if useStake and table.find(stakeBodies, item:getId()) and stake then\n          useWith(stake, item)\n          return\n        end\n      end\n    end\n  end\nend)\n\n",
