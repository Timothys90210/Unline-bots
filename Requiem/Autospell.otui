CombinedAutoSpellWindow < MainWindow
  text: Combined AutoSpell Configuration
  width: 330
  height: 600

  Label
    anchors.left: parent.left
    anchors.top: parent.top
    text-align: left
    !text: tr('Write the name of your pet')

  Label
    anchors.left: parent.left
    anchors.top: prev.bottom
    text-align: left
    !text: tr('So bot excludes it from counting')

  TextEdit
    id: name
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 90
    margin-top: 5
  
  Label
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: parent.left
    text: Pet Name:

  Panel
    id: headerPanel
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    margin-top: 5
    margin-left: 10
    margin-right: 30

    Label
      id: countLabel
      text: Count
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 50
      text-align: center

    Label
      text: Priority
      anchors.right: countLabel.left
      margin-right: 5
      anchors.verticalCenter: parent.verticalCenter
      width: 50
      text-align: center

  Button
    id: ok
    !text: tr('Save')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 60
    margin-left: 10

  Button
    id: cancel
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    margin-left: 10
    width: 60

  VerticalScrollBar
    id: contentScroll
    anchors.top: headerPanel.bottom
    anchors.right: parent.right
    anchors.bottom: ok.top
    step: 38
    pixels-scroll: true
    margin-right: -10
    margin-top: 5
    margin-bottom: 5

  ScrollablePanel
    id: content
    anchors.top: headerPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    vertical-scrollbar: contentScroll
    margin-bottom: 10
    
    Panel
      id: msSpellsPanel
      visible: false
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 10
      margin-right: 20
      margin-top: 5
      layout:
        type: verticalBox
        spacing: 10
        fit-children: true
      
      Panel
        height: 22
        Button
          id: ms_exori_flam_toggle
          text: (8) Flame Strike
          width: 140
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text-align: center
          checkable: true
        SpinBox
          id: ms_exori_flam_priority_2
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          width: 50
          minimum: 1
          maximum: 10
        SpinBox
          id: ms_exori_flam_priority_1
          anchors.right: ms_exori_flam_priority_2.left
          margin-right: 5
          anchors.verticalCenter: parent.verticalCenter
          width: 50
