  "ingame_hotkeys": "local amulet = 3048\nlocal equip_ammy = 3048\nSsa = macro(100, \"M-RING Perma\", function() \n    if hppercent() <= 70 and (getFinger() == null or getFinger():getId() ~= amulet) then\n            g_game.equipItemId(amulet)\n            delay(200)\n    elseif hppercent() >= 90 and (getFinger() == null or equip_ammy and getFinger():getId() ~= equip_ammy) then\n        g_game.equipItemId(equip_ammy)\n        delay(200)\n    end\nend)\nlocal amulet = 3081\nlocal equip_ammy = 3081\nSsa = macro(100, \"AMULETO\", function() \n    if hppercent() <= 75 and (getNeck() == null or getNeck():getId() ~= amulet) then\n            g_game.equipItemId(amulet)\n            delay(200)\n    elseif hppercent() >= 90 and (getNeck() == null or equip_ammy and getNeck():getId() ~= equip_ammy) then\n        g_game.equipItemId(equip_ammy)\n        delay(200)\n    end\nend)\n\nlocal autoUtamoVita = macro(250, \"Auto Utamo Vita\", function()\n    if hppercent() < 75 and not hasManaShield() then\n        say(\"utamo vita\")\n    elseif hppercent() > 90 and hasManaShield() then\n\n        say(\"utamo vita\")\n    end\nend)\n\naddIcon(\"AutoUtamoVita\", {item=3321, text=\"Utamo\"}, function(icon, isOn)\n    if isOn then\n        autoUtamoVita.setOn(true)\n    else\n        autoUtamoVita.setOn(false)\n        -- Solo lanza utamo vita si no tienes el buff activo\n        if not hasManaShield() then\n            say(\"utamo vita\")\n        end\n    end\nend)\n\nlocal function checkPos(x, y)\n  xyz = g_game.getLocalPlayer():getPosition()\n  xyz.x = xyz.x + x\n  xyz.y = xyz.y + y\n  tile = g_map.getTile(xyz)\n  if tile then\n    autoWalk(tile:getPosition(), 20, {ignoreNonPathable=true, precision=3})\n  end\nend\n\nconsoleModule = modules.game_console\nmacro(1, 'Bug Map', function() \n  if modules.corelib.g_keyboard.isKeyPressed('up') then\n    checkPos(0, -5)\n  elseif modules.corelib.g_keyboard.isKeyPressed('right') then\n    checkPos(5, 0)\n  elseif modules.corelib.g_keyboard.isKeyPressed('down') then\n    checkPos(0, 5)\n  elseif modules.corelib.g_keyboard.isKeyPressed('left') then\n    checkPos(-5, 0)\n  end\nend)\n\nlocal runeId = 52813\nlocal healPercent = 45\nlocal friendList = {\"Sabrina\", } \n\nlocal minMana = 10 -- minimum mana % to uh friend\nlocal minHp = 60   -- minimum health % to uh friend\n\n-- script\n\nlocal runeId = 52813\nlocal healPercent = 80\nlocal friendList = {\"Alastor Moody\"} \n\n\n\nlocal minMana = 10 -- minimum mana % to uh friend\nlocal minHp = 40   -- minimum health % to uh friend\n\n-- script\n\nmacro(250, \"UHFRIENDS\", function()\n    for _, spec in pairs(getSpectators()) do\n        if table.find(friendList, spec:getName()) and hppercent() >= minHp and manapercent() >= minMana then\n            if spec:getHealthPercent() <= healPercent then\n                useWith(runeId, spec)\n            end\n        end\n    end\nend)\n\n\nonCreatureAppear(function(creature)\n  if creature:isPlayer() and table.find(storage.playerList.friendList, creature:getName(), true) then\n    creature:setInformationColor(\"orange\")\n  end\nend)\n\nonCreatureAppear(function(creature)\n  if creature:isPlayer() and table.find(storage.playerList.enemyList, creature:getName(), true) then\n    creature:setInformationColor(\"red\")\n  end\nend)\n\nmacro(1000, \"Ask Party\", function()\n  if not player:isPartyMember() then\n    say(\"pt\")\n    delay(5000)\n  end\nend)\n\nmacro(1000, \"Accept Party\", function()\n  if player:isPartyMember() then return end\n  for _, spec in ipairs(getSpectators(posz())) do\n    if spec:isPlayer() and spec ~= player and spec:getShield() == 1 then\n      g_game.partyJoin(spec:getId())\n      break\n    end        \n  end\nend)\n\nlocal m_main = macro(10000, \"Invite To Party\", function() end)\n\nonTalk(function(name, level, mode, text, channelId, pos)\n  if m_main.isOff() then return end\n  if text:lower() == \"pt\" then\n    local c = getCreatureByName(name)\n    if c and isFriend(name) then\n      g_game.partyInvite(c:getId())\n    end\n  end\nend)\n\n\n-- Macro de rotación de spells:\n-- Exevo gran gran tera (20s cd), Exevo gran mas tera (9s cd), Avalanche Rune (cada 2s entre spells, por ID y en el target)\n\nlocal last_ggt = 0         -- Exevo gran gran tera\nlocal last_gmt = 0         -- Exevo gran mas tera\nlocal last_avalanche = 0   -- Avalanche rune\n\nlocal avalancheRuneId = 52820 -- Cambia este ID si tu rune tiene otro\n\nmacro(100, \"Rotación de Spells\", function()\n    local now = os.clock()\n\n    -- Exevo gran gran tera cada 20s\n    if now - last_ggt >= 20 then\n        say('exevo gran gran tera')\n        last_ggt = now\n        return\n    end\n\n    -- Exevo gran mas tera cada 9s\n    if now - last_gmt >= 9 then\n        say('exevo gran mas tera')\n        last_gmt = now\n        return\n    end\n\n    -- Avalanche rune cada 2s entre spells, usando ID y en el target\n    if now - last_avalanche >= 2 and g_game.getAttackingCreature() then\n        g_game.useInventoryItemWith(avalancheRuneId, g_game.getAttackingCreature())\n        last_avalanche = now\n        return\n    end\nend)\n\nmacro(200, \"Off PvP - Cave ON\", function()\n  if CaveBot.isOn() then\n  g_game.setSafeFight(true)\nend\nend)\n\n\nlocal interface = modules.game_interface\nlocal leftPanel = interface:getLeftPanel()\nleftPanel:setWidth(230)\n\n\nlocal healingRuneId = 52813 -- Set the healing rune ID here\nlocal petName = \"Lil Dread\" -- Set your pet's name here\nlocal healPercent = 70 -- Set the heal percentage here\naddIcon(\"petHealer\", {item={id=healingRuneId, count=1}, text=\"PetHeal\"}, macro(50, function()\n    for i, spec in ipairs(getSpectators()) do\n        if spec:getName() == petName and spec:getHealthPercent() < healPercent then\n            local healItem = findItem(healingRuneId)\n            if healItem then\n                useWith(healItem, spec)\n            end\n        end\n    end\nend))\n\nlocal config = {\n  item = {\n    id = 52820,\n    minQty = 300\n  },\n\n  pos = {x=0000, y=0000, z=0}\n}\n\nmacro(200, \"Teras\", function()\n  local qty = player:getItemsCount(config.item.id)\n  if manapercent() > 60 and qty < config.item.minQty then\n  say(\"adori mas tera\")\n  end\nend)\n\nsetDefaultTab(\"Cave\")\nUI.Separator()\n\nwepLabel = UI.Label(\"Bot Tools\")\ncheck = false\n\nmacro(100, \"Bless & AOL Check\", function()\n    local neck = getNeck()\n    local hasAol = neck and neck:getId() == 3057\n    local hasBless = player:getBlessings() > 0\n\n    if not hasBless and not hasAol then\n        if CaveBot.isOn() or TargetBot.isOn() then\n            CaveBot.setOff()\n            TargetBot.setOff()\n            return true\n        end\n    end\nend)\n\n--[[\n  +---------------------------------------------------------------+\n  ¦   Script by Lee (Discord: l33_)                               ¦\n  ¦   URL: https://www.trainorcreations.com/coding/otclient/114   ¦\n  ¦---------------------------------------------------------------¦\n  ¦   Website: https://trainorcreations.com                       ¦\n  ¦   Donate: https://trainorcreations.com/donate                 ¦\n  ¦   Discord: https://trainorcreations.com/discord               ¦\n  ¦---------------------------------------------------------------¦\n  ¦   PS: Stop ripping off my work and selling it.                ¦\n  +---------------------------------------------------------------+\n]]--\nlocal useLoot = macro(100000, \"Loot Channel\", function() end)\nlocal tabName = \"Loot\"\nlocal console = modules.game_console\n\nonTextMessage(function(mode, text)\n  if mode ~= 29 then return end\n  if useLoot.isOff() then return end\n  if not text:find(\"Loot of\") then return end\n\n  local tab = console.getTab(tabName) or console.addTab(tabName, true)\n  console.addText(text, { color = '#00EB00' }, tabName, \"\")\nend)\n\nsetDefaultTab(\"Tools\")\nmacro(1000, \"Open next BP\", function()\n  local bpID = 3253\n  local containers = getContainers()\n  for i, container in pairs(containers) do\n    if container:getItemsCount() == container:getCapacity() and container:getContainerItem():getId() == bpID then\n      local itemsContained = container:getItems()\n      g_game.open(itemsContained[container:getCapacity()], container)\n    end\n  end\nend)\n\nlocal hpPercent = 95\nmacro(50, \"faster healing\",  function()\n  if (hppercent() <= hpPercent) then\n  say(storage.HealText)\nend\nend)\naddTextEdit(\"HealText\", storage.HealText or \"NAZWASPELLA\", function(widget, text)\nstorage.HealText = text\nend)\n\nmacro(5000, \"Auto-Mount\", function() \n    if isInPz() then return end\n    if not player:isMounted() then player:mount() end\nend)\n \nlocal autoMount = macro(60000, \"Walk Mount\", function() end)\nonPlayerPositionChange(function()\n    if autoMount:isOff() or isInPz() or player:isMounted() then return end\n    player:mount()\nend)",
