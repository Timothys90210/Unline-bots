CaveBotConfigPanel < Panel
  id: cavebotEditor
  visible: false
  
  layout:
    type: verticalBox
    fit-children: true
  
  HorizontalSeparator
    margin-top: 5

  Label
    text-align: center
    text: CaveBot Config
    margin-top: 5

CaveBotConfigNumberValuePanel < Panel
  height: 20
  margin-top: 5

  Label
    id: title
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    margin-right: 5
    text-wrap: false
    elide: none
    auto-shrink: true         # ← This is the key!
    min-font-size: 5 
    font-size: 10

  BotTextEdit
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    width: 50

CaveBotConfigBooleanValuePanel < Panel
  height: 20
  margin-top: 5

  Label
    id: title
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    margin-right: 5
    text-wrap: true
    elide: none
    text-auto-resize: true   # ← This is the key!

  BotSwitch
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    width: 50

    $on:
      text: On

    $!on:
      text: Off